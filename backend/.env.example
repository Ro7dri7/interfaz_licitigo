# Copia este archivo a .env (en Windows: copy .env.example .env) y completa los valores. .env NO se sube a git.

# Supabase del proyecto (base compartida del equipo). Solo backend: nunca en el frontend.
SUPABASE_URL=https://jwxdwszinjdhzoierizm.supabase.co
SUPABASE_SECRET_KEY=PEGA_AQUI_LA_SECRET_KEY_DE_SUPABASE

# API MIGO (https://api.migo.pe): consulta SUNAT por RUC
APIMIGO_TOKEN=PEGA_AQUI_EL_TOKEN_DE_API_MIGO

# Webhook del flujo n8n "Analizador ISO Licitaciones" (nodo "Webhook Desbloqueo", URL de producción).
# Usa TU PROPIO n8n con TU API key de Gemini (ver n8n/README.md).
#   Ej. n8n local: http://localhost:5678/webhook/desbloquear-licitacion-gemini
# Vacío = la app funciona igual (buscar, desbloquear, ver bases) pero sin el análisis ISO con IA.
N8N_WEBHOOK_URL=
# Segundos máximos que se espera la respuesta de n8n
N8N_TIMEOUT_SEC=300

# Token del bot creado con @BotFather en Telegram (opcional)
TELEGRAM_BOT_TOKEN=
# Cada cuántos minutos el bot revisa nuevas licitaciones, y cuántas manda por aviso como máximo
ALERT_INTERVAL_MIN=10
ALERT_MAX_POR_ENVIO=5

# Segundos que se cachean en memoria las sugerencias del catálogo CUBSO por CIIU
CACHE_TTL_SEC=300
# Orígenes permitidos (separados por coma) para llamar a la API desde el navegador
CORS_ORIGINS=http://localhost:5173
